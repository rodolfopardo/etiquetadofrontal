# Vercel AI Gateway — la clave principal para llamar al modelo de visión
# Sacala desde: https://vercel.com/dashboard/ai-gateway
AI_GATEWAY_API_KEY=

# Modelo por default (formato "provider/model" del AI Gateway)
# Recomendados por costo/precisión para OCR de tablas nutricionales:
#   - google/gemini-2.5-flash   (más barato, ~$0.001/foto)
#   - anthropic/claude-haiku-4-5 (alternativa, ~$0.002/foto)
#   - openai/gpt-4o-mini        (alternativa, ~$0.003/foto)
AI_MODEL=google/gemini-2.5-flash

# Rate limit por IP (fotos por día). Default: 15
RATE_LIMIT_PER_DAY=15

# ─── SEO / Analytics ────────────────────────────────────────────────
# URL del sitio (solo si NO estás deployando en Vercel, donde se
# resuelve solo desde VERCEL_PROJECT_PRODUCTION_URL).
# NEXT_PUBLIC_SITE_URL=https://etiquetadofrontal.com.ar

# Google Tag Manager Container ID. Desde GTM podés disparar GA4,
# Meta Pixel, conversiones, etc. sin tocar código.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Analytics 4 Measurement ID. Opcional — solo si querés
# cargar GA4 directo en vez de hacerlo a través de GTM.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Token de verificación de Google Search Console (meta tag).
# Sacalo del paso "Otros métodos de verificación → Etiqueta HTML"
# y pegá solo el valor del content="...", sin el meta completo.
# NEXT_PUBLIC_GSC_VERIFICATION=abcdef1234567890abcdef
